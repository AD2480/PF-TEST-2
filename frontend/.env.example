# ProjectFlow frontend configuration
# Copy to `.env.local` and adjust. The frontend holds no secrets: everything here ends up in the
# public JavaScript, and a production build refuses to finish if it finds a secret key.

# true  -> DEMO MODE: an in-browser mock API (data lives only in this browser's localStorage).
#          The app shows a "Demo mode" badge so it is never mistaken for the real backend.
# false -> call the Spring Boot backend at VITE_API_BASE_URL (MySQL persistence, real permissions).
VITE_USE_MOCK_API=true

# Base URL of the Spring Boot REST API (used when VITE_USE_MOCK_API=false). Must be https:// when deployed.
# `/api` goes through the Vite dev-server proxy to http://localhost:8080.
VITE_API_BASE_URL=/api

# With the real backend, list the seeded sample accounts on the sign-in page. Never on a public site.
VITE_SHOW_SAMPLE_ACCOUNTS=false

# The site's public address (canonical links, social previews, sitemap.xml). On Vercel the
# production domain is used automatically when this is empty.
# VITE_SITE_URL=https://projectflow.vercel.app

# Named on the privacy policy and terms, and where people can reach you.
# VITE_OPERATOR_NAME=Your name or organisation
# VITE_CONTACT_EMAIL=help@yourdomain.com

# Cloudflare Turnstile site key (public). The backend needs the matching TURNSTILE_SECRET_KEY.
# VITE_TURNSTILE_SITE_KEY=0x4AAAA...

# Analytics, loaded only after a visitor agrees in the cookie banner:
# VITE_ANALYTICS=vercel            # Vercel Web Analytics (enable it in the Vercel project too)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXX # Google Analytics 4
